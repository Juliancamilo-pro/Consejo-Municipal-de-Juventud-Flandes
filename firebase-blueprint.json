        "achievements": { "type": "array" },
        "skills": { "type": "array" },
        "featuredQuote": { "type": "string", "maxLength": 140 },
        "projectIds": { "type": "array" },
        "socialLinks": { "type": "object" },
        "publicEmail": { "type": "string", "maxLength": 160 },
