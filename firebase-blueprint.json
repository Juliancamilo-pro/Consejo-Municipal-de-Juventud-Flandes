        "slug": { "type": "string", "maxLength": 140 },
        "photoUrl": { "type": "string", "maxLength": 1500 },
        "role": {
          "type": "string",
          "enum": ["secretario_admin", "presidente", "vicepresidente", "lider_comision", "consejero"]
