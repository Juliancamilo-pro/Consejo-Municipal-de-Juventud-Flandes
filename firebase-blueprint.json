        "fullBio": { "type": "string", "maxLength": 3000 },
        "educationOccupation": { "type": "string", "maxLength": 240 },
        "motivation": { "type": "string", "maxLength": 1500 },
        "proposals": { "type": "string", "maxLength": 2500 },
