        "commissionName": { "type": "string", "maxLength": 140 },
        "positionTitle": { "type": "string", "maxLength": 120 },
        "sector": { "type": "string", "maxLength": 120 },
        "shortBio": { "type": "string", "maxLength": 280 },
        "bio": { "type": "string", "maxLength": 800 },
        "fullBio": { "type": "string", "maxLength": 3000 },
        "educationOccupation": { "type": "string", "maxLength": 240 },
        "motivation": { "type": "string", "maxLength": 1500 },
        "proposals": { "type": "string", "maxLength": 2500 },
