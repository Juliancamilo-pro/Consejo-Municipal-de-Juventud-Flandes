rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }

    function isUnderSizeLimit(maxMb) {
      return request.resource != null && request.resource.size <= maxMb * 1024 * 1024;
    }

    function isAllowedMedia() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType.matches('application/.*')
        || request.resource.contentType.matches('text/.*');
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSignedIn() && isAllowedMedia() && isUnderSizeLimit(50);
      allow delete: if isSignedIn();
    }

    match /profiles/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isAllowedMedia() && isUnderSizeLimit(15);
      allow delete: if isSignedIn();
    }

    match /commissions/{commissionId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSignedIn() && isAllowedMedia() && isUnderSizeLimit(150);
      allow delete: if isSignedIn();
    }

    match /documents/{docId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSignedIn() && isAllowedMedia() && isUnderSizeLimit(50);
      allow delete: if isSignedIn();
    }

    match /gallery/{itemId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSignedIn() && isAllowedMedia() && isUnderSizeLimit(150);
      allow delete: if isSignedIn();
    }
  }
}
