# Variables de entorno del servidor (configurar en Vercel / Secrets del entorno)
# Ningún secreto real debe escribirse en este archivo.

# Correo del Secretario Administrador para activación inicial única
ADMIN_EMAIL=""

# Código inicial de invitación para registro de consejeros (validado solo en el servidor)
CMJ_INVITATION_CODE=""

# Secreto HMAC/AES para firmar cookies httpOnly y cifrar el código de invitación rotado
SESSION_SECRET=""

# JSON de la cuenta de servicio de Firebase Admin SDK codificado en base64
FIREBASE_SERVICE_ACCOUNT=""

# URL pública oficial de la aplicación (ej. https://cmj-flandes.vercel.app)
APP_URL=""

# Puerto del servidor Express local (por defecto 3000)
PORT="3000"

# Notificaciones por correo configurables (opcional; solo servidor)
RESEND_API_KEY=""
EMAIL_FROM=""
SMTP_WEBHOOK_URL=""
SMTP_WEBHOOK_TOKEN=""

# Nota Google Workspace (Docs, Sheets, Calendar):
# Usa flujo OAuth del cliente provisto por la plataforma (sin secretos en el frontend ni redirección de servidor).
