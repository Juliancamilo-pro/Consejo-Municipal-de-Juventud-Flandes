# URL pública de la aplicación
APP_URL="MY_APP_URL"

# Opcional: URL base del backend si frontend y API se alojan en dominios distintos
# (déjalas vacías cuando Vercel o Express sirvan /api en el mismo dominio)
VITE_API_URL=""
NEXT_PUBLIC_API_URL=""
CORS_ALLOWED_ORIGINS=""

# Conexión a PostgreSQL (usa DATABASE_URL en Vercel/Neon/Supabase o las variables SQL_*)
DATABASE_URL=""
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Opcional: sobrescribir clave inicial o código de invitación institucional
CMJ_INITIAL_PASSWORD=""
CMJ_INVITE_CODE=""
